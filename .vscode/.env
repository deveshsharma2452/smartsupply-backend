# Copy this file to .env and fill in real values. Never commit the real .env file.

DB_USER=postgres
DB_PASSWORD=changeme
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smartsupply

# Optional: enables AI-generated executive summaries via Gemini.
# If left blank, the app falls back to a plain-text offline summary.
GEMINI_API_KEY=

# Comma-separated list of allowed frontend origins, e.g.:
# CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:5173
# Defaults to "*" (open) if unset, which is fine for local dev only.
CORS_ALLOWED_ORIGINS=*
